+        private static bool CanPropagate(IAstNode source)
+        {
+            if (source is AstOperand operand)
+            {
+                return operand.Type switch
+                {
+                    OperandType.Constant or OperandType.ConstantBuffer or OperandType.Undefined => true,
+                    OperandType.LocalVariable => operand.Defs.Count == 1,
+                    _ => false,
+                };
+            }
+
+            if (source is AstOperation op)
+            {
+                if (HasSideEffects(op))
+                {
+                    return false;
+                }
+
+                switch (op.Inst & Instruction.Mask)
+                {
+                    case Instruction.Load:
+                        if (op.StorageKind is not (StorageKind.ConstantBuffer or StorageKind.Input or StorageKind.InputPerPatch))
+                        {
+                            return false;
+                        }
+
+                        if (op.StorageKind == StorageKind.Input &&
+                            op.SourcesCount > 0 &&
+                            op.GetSource(0) is AstOperand ioOp &&
+                            (IoVariable)ioOp.Value == IoVariable.ThreadKill)
+                        {
+                            return false;
+                        }
+                        break;
+
+                    case Instruction.ImageLoad:
+                    case Instruction.ImageStore:
+                    case Instruction.Store:
+                    case Instruction.Barrier:
+                    case Instruction.GroupMemoryBarrier:
+                    case Instruction.MemoryBarrier:
+                    case Instruction.Discard:
+                    case Instruction.EmitVertex:
+                    case Instruction.EndPrimitive:
+                    case Instruction.FSIBegin:
+                    case Instruction.FSIEnd:
+                    case Instruction.Return:
+                    case Instruction.LoopBreak:
+                    case Instruction.LoopContinue:
+                    case Instruction.Ballot:
+                    case Instruction.Shuffle:
+                    case Instruction.ShuffleDown:
+                    case Instruction.ShuffleUp:
+                    case Instruction.ShuffleXor:
+                    case Instruction.VoteAll:
+                    case Instruction.VoteAllEqual:
+                    case Instruction.VoteAny:
+                    case Instruction.SwizzleAdd:
+                    case Instruction.Ddx:
+                    case Instruction.Ddy:
+                    case Instruction.Lod:
+                    case Instruction.TextureSample:
+                        return false;
+                }
+
+                for (int i = 0; i < op.SourcesCount; i++)
+                {
+                    if (!CanPropagate(op.GetSource(i)))
+                    {
+                        return false;
+                    }
+                }
+
+                return true;
+            }
+
+            return false;
+        }
