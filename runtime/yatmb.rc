/* The application manifest (yatmb.manifest), icon (yatmb.ico), and PE version info of yatmb.exe.
   tools/build_game.py compiles it with the runtime objects. */
#include <winver.h>

1 24 "yatmb.manifest"
1 ICON "yatmb.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,2,0
 PRODUCTVERSION 0,1,2,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Yoshi and the Mysterious Book"
            VALUE "FileVersion", "0.1.2.0"
            VALUE "InternalName", "yatmb"
            VALUE "OriginalFilename", "yatmb.exe"
            VALUE "ProductName", "Yoshi and the Mysterious Book"
            VALUE "ProductVersion", "0.1.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
