#version 450
layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly  buffer MirrorBuf { uvec4 mbuf[];  };
layout(set = 0, binding = 1, std430)           buffer SnapBuf   { uvec4 msnap[]; };
layout(set = 0, binding = 2, std430) writeonly buffer HostBuf   { uvec4 host[];  };

layout(push_constant) uniform PC {
    uint count_vec4;
};

void main() {
    uint stride = gl_NumWorkGroups.x * 256u;
    for (uint i = gl_GlobalInvocationID.x; i < count_vec4; i += stride) {
        uvec4 v = mbuf[i];
        uvec4 s = msnap[i];
        if (any(notEqual(v, s))) {
            msnap[i] = v;
            host[i] = v;
        }
    }
}
